{
  "siteUrl": "https://www.multicalci.com",
  "pagesDir": ".",
  "outFile": "sitemap.xml",
  "trailingSlash": true,
  "maxUrlsPerFile": 45000,

  "excludeDirs": [
    "node_modules",
    ".git",
    ".github",
    "api",
    "assets",
    "static",
    "scripts",
    "dist",
    ".vercel",
    "tests",
    "validation",
    "admin"
  ],

  "excludeRoutes": [
    "/404",
    "/500",
    "/thank-you",
    "/admin",
    "/schema-preview"
  ],

  "extraRoutes": [],

  "rules": [
    { "match": "^/$",                                                   "priority": "1.0", "changefreq": "weekly"  },

    { "match": "-calculator/?$",                                        "priority": "0.9", "changefreq": "monthly" },
    { "match": "-(sizing|design|performance|properties|calculators)/?$","priority": "0.9", "changefreq": "monthly" },
    { "match": "^/(gas-equation-of-state|material-grades-library|material-of-construction)/?$", "priority": "0.9", "changefreq": "monthly" },

    { "match": "^/unit-converter/?$",                                   "priority": "0.9", "changefreq": "monthly" },
    { "match": "^/unit-converter/",                                     "priority": "0.8", "changefreq": "monthly" },

    { "match": "^/engineering-standards-finder/?$",                     "priority": "0.8", "changefreq": "weekly"  },
    { "match": "^/engineering-standards-finder/equipment/",             "priority": "0.6", "changefreq": "yearly"  },
    { "match": "^/engineering-standards-finder/standards/",             "priority": "0.6", "changefreq": "yearly"  },

    { "match": "^/(contact|about|privacy|terms|disclaimer)/?$",         "priority": "0.3", "changefreq": "yearly"  },

    { "match": ".*",                                                    "priority": "0.7", "changefreq": "monthly" }
  ]
}
